KAKAO_REST_API_KEY=your-kakao-rest-api-key
VWORLD_API_KEY=your-vworld-api-key
VWORLD_API_REFERER=https://jmgj-frontend.onrender.com
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://jmgj-frontend.onrender.com,https://jmgj-frontend.vercel.app

METEOBLUE_API_KEY=your-meteoblue-api-key
SKY_BRIGHTNESS_RADIUS_KM=30
SKY_BRIGHTNESS_MAX_PIXELS=1000

# Optional local assets for the full Black Marble + DEM SQM pipeline.
# In Render, attach a persistent disk and point these paths to that disk.
BLACK_MARBLE_H5_PATH=/var/data/black_marble/black-marble.h5
DEM_RASTER_PATH=/var/data/dem/korea-dem.img

# Optional GitHub Release asset URLs. scripts/download_assets.py downloads these
# into the paths above if the files are missing.
BLACK_MARBLE_H5_URL=https://github.com/gyeon27/JMGJ/releases/download/data-assets-2026-06/black-marble.h5
DEM_RASTER_URL=https://github.com/gyeon27/JMGJ/releases/download/data-assets-2026-06/korea-dem.img

# Optional minimum sizes in bytes. Use these to catch failed HTML/error downloads.
BLACK_MARBLE_H5_MIN_BYTES=100000000
DEM_RASTER_MIN_BYTES=100000000

# Set to true only when deployment must fail if either asset cannot be downloaded.
REQUIRE_SKY_ASSETS=false
